# Gjallar local runtime
FRONTEND_PORT=5173
BACKEND_PORT=8000
VITE_BACKEND_URL=http://127.0.0.1:8000

GJALLAR_DATABASE_URL=postgresql+psycopg://gjallar:change-me@127.0.0.1:5432/gjallar

# Optional one-time bootstrap admin for first container startup. Leave unset
# after the first login and rotate/change the password from the UI or CLI.
# GJALLAR_BOOTSTRAP_ADMIN_USERNAME=admin
# GJALLAR_BOOTSTRAP_ADMIN_PASSWORD=

# Optional local single-origin SPA serving. The Docker image sets this to
# /app/frontend-dist; leave unset for normal Vite dev.
# GJALLAR_FRONTEND_DIST=frontend/dist

# Inventory mode: auto uses live Proxmox when configured, fake uses local demo data.
GJALLAR_INVENTORY_MODE=auto

# Live Proxmox API. Leave blank to use fake inventory fallback in auto mode.
# PROXMOX_API_URL=https://pve.example.local:8006/api2/json
# PROXMOX_API_TOKEN_ID=root@pam!gjallar
# PROXMOX_API_TOKEN_SECRET=
# PROXMOX_TLS_INSECURE=false
# PROXMOX_API_CONNECT_TIMEOUT_SECONDS=5
# PROXMOX_API_READ_TIMEOUT_SECONDS=15
# PROXMOX_VM_INVENTORY_CACHE_TTL_SECONDS=10
# PROXMOX_VM_INVENTORY_WORKERS=8
# PROXMOX_GUEST_AGENT_TIMEOUT_SECONDS=3

# Optional default SSH key for Create VM access payloads.
# GJALLAR_DEFAULT_SSH_PUBLIC_KEY=
# GJALLAR_DEFAULT_SSH_PUBLIC_KEY_FILE=
